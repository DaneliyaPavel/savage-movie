# Dockerfile для Python FastAPI Backend
FROM python:3.11-slim

WORKDIR /app

# Установка системных зависимостей
RUN apt-get update && apt-get install -y \
    postgresql-client \
    gosu \
    && rm -rf /var/lib/apt/lists/*

# Копирование requirements и установка зависимостей (увеличен таймаут для нестабильной сети)
COPY backend/requirements.txt .
ENV PIP_DEFAULT_TIMEOUT=300
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Копирование кода приложения
COPY backend/ ./backend/

# Создание директории для загрузок
RUN mkdir -p /app/backend/uploads/images /app/backend/uploads/videos

# Переменные окружения
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app/backend
ENV PATH="/app/backend:$PATH"

# Создание non-root пользователя
RUN addgroup --system --gid 1001 appuser && \
    adduser --system --uid 1001 --ingroup appuser appuser
RUN chown -R appuser:appuser /app/backend/uploads

# Entrypoint: чиним права на смонтированный uploads volume (нужен root),
# затем через gosu сбрасываем привилегии на appuser.
COPY backend/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Порт
EXPOSE 8000

# Контейнер стартует как root и через gosu переключается на appuser
# (см. docker-entrypoint.sh). Это позволяет починить ownership bind-mount'а
# uploads и при этом запускать само приложение под non-root.
WORKDIR /app/backend
ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
