# Frontend (без /api в конце)
# Local: http://localhost:8001 | Production: https://savagemovie.ru
NEXT_PUBLIC_API_URL=http://localhost:8001
# Local: http://localhost:3000 | Production: https://savagemovie.ru
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Production: true (requires HTTPS)
COOKIE_SECURE=false
NEXT_PUBLIC_CALENDLY_URL=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_YANDEX_CLIENT_ID=
NEXT_PUBLIC_MUX_ENV_KEY=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_SHOWREEL_PLAYBACK_ID=

# Backend / API
API_URL=http://backend:8000
# Local: http://localhost:3000 | Production: https://savagemovie.ru
APP_URL=http://localhost:3000
# Production: https://savagemovie.ru,https://www.savagemovie.ru
CORS_ORIGINS=http://localhost:3000
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# Почта, на которую падают все заявки с форм сайта
ADMIN_EMAIL=hello@savagemovie.ru
# Опционально: второй канал доставки заявок письмом.
# Требует верифицированного домена в Resend, иначе отправка падает.
RESEND_API_KEY=
# Отправитель писем, домен должен быть верифицирован в Resend
RESEND_FROM_EMAIL=noreply@savagemovie.ru

# Database
DB_HOST=db
DB_PORT=5433
DB_NAME=savage_movie
DB_USER=postgres
DB_PASSWORD=postgres

# Images (CI/CD)
REGISTRY=ghcr.io/daneliyapavel
IMAGE_TAG=latest

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production: https://savagemovie.ru/api/auth/oauth/google/callback
GOOGLE_REDIRECT_URI=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
# Production: https://savagemovie.ru/api/auth/oauth/yandex/callback
YANDEX_REDIRECT_URI=

# Payments
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Media
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# SMTP (Яндекс 360) — основной канал доставки заявок.
# SMTP_PASSWORD — это пароль приложения из Яндекс ID, а не пароль от почты.
# Отправитель должен совпадать с ящиком SMTP_USER или быть его алиасом.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=hello@savagemovie.ru
SMTP_PASSWORD=
SMTP_FROM=hello@savagemovie.ru

# Telegram Bot — второй канал доставки заявок с форм сайта.
# TELEGRAM_BOT_TOKEN — токен бота от @BotFather (он выступает отправителем).
# TELEGRAM_CHAT_ID — id чата или группы, куда бот кладёт заявку.
# Заявка считается принятой, если сработал хотя бы один канал (Telegram или Resend).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# С российского хостинга api.telegram.org недоступен. Если поднято реле
# на сервере вне РФ — укажи его адрес здесь, иначе оставь пустым.
TELEGRAM_API_BASE=

# Other
UPLOAD_DIR=
