# Реле Telegram Bot API.
#
# Ставится на СЕРВЕР ВНЕ РФ, а не на основной VDS. Нужен потому, что с
# российского хостинга api.telegram.org недоступен: на корень отвечает
# заглушка провайдера, а сами запросы к /bot<token>/... уходят в таймаут.
#
# Порядок:
#   1) Cloudflare → DNS → добавить A-запись:
#        tg  →  <IP французского VPS>
#      ОБЯЗАТЕЛЬНО серая тучка (DNS only), НЕ оранжевая. При проксировании
#      Cloudflare терминирует TLS и видит токен бота, а nginx получает IP
#      Cloudflare вместо основного сервера — allow ниже отрежет всё подряд.
#   2) На французском VPS СНАЧАЛА выпустить сертификат, иначе nginx с этим
#      конфигом не стартует — ssl_certificate ниже указывает на несуществующий
#      файл. Порт 80 должен быть свободен:
#        systemctl stop nginx
#        certbot certonly --standalone -d tg.savagemovie.ru
#   3) Положить этот файл в /etc/nginx/conf.d/telegram-relay.conf, затем:
#        nginx -t && systemctl start nginx
#   4) На основном сервере в .env:
#        TELEGRAM_API_BASE=https://tg.savagemovie.ru
#      и перезапуск: docker compose up -d frontend
#   5) Проверить: ./scripts/check-contact-delivery.sh
#
# ВАЖНО про безопасность: токен бота передаётся прямо в пути запроса,
# поэтому реле обязано быть закрыто по IP основного сервера и работать
# только по HTTPS. Открытое реле = отданный наружу токен.

server {
    # Без http2: директива http2 on; появилась только в nginx 1.25.1, а на
    # Ubuntu 24.04 приезжает 1.24. Для редких мелких запросов к Bot API
    # HTTP/2 всё равно ничего не даёт.
    listen 443 ssl;
    server_name tg.savagemovie.ru;

    ssl_certificate     /etc/letsencrypt/live/tg.savagemovie.ru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tg.savagemovie.ru/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    # Токен не должен попадать в логи — путь пишется целиком.
    access_log off;

    location / {
        # IP основного сервера (прод savagemovie.ru). Если сменишь хостинг —
        # поменяй и здесь, иначе реле перестанет пускать.
        allow 89.169.4.92;
        deny all;

        proxy_pass https://api.telegram.org;
        proxy_ssl_server_name on;
        proxy_ssl_name api.telegram.org;
        proxy_set_header Host api.telegram.org;

        # Заявки уходят быстро, но пусть будет запас на медленную сеть.
        proxy_connect_timeout 10s;
        proxy_send_timeout    20s;
        proxy_read_timeout    20s;

        # Форма отправляет компактный JSON, большие тела не нужны.
        client_max_body_size 1m;
    }
}

# Простой редирект с http на https, чтобы не ходить в открытую.
server {
    listen 80;
    server_name tg.savagemovie.ru;
    return 301 https://$host$request_uri;
}
